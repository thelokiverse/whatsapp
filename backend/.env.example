# Postgres connection string (Supabase free tier -> Project Settings > Database > Connection string)
DATABASE_URL=postgresql://user:password@host:5432/postgres

# Server
PORT=3000

# WhatsApp Cloud API (Meta for Developers)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=

# LLM (Gemini free tier)
GEMINI_API_KEY=

# Dashboard auth
JWT_SECRET=

# Shared secret the external cron must send as X-Trigger-Secret to call
# /trigger-daily and /check-followups
TRIGGER_SECRET=

# WorkoutX exercise API (free tier -> https://workoutxapp.com)
WORKOUTX_API_KEY=
